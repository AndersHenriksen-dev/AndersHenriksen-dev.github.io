{
  "permissions": {
    "allow": [
      "Bash(hugo:*)",
      "Bash(uvx pre-commit run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push --force-with-lease *)",
      "Bash(gh pr merge *)",
      "Bash(git push origin master*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env:*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --mirror *)",
      "Bash(git filter-branch *)",
      "Bash(gh repo delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_python_style_read.py\"",
            "timeout": 15,
            "statusMessage": "Checking python-style.md was read..."
          }
        ]
      }
    ]
  }
}
